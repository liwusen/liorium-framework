# Liorium CLI 配置模板：复制成 .env 再改值（.env 已被 .gitignore 忽略）
#
# 优先级：命令行参数 > 进程环境变量 > 本文件 > 内置默认
# 加载顺序：$env:LIORIUM_ENV_FILE → ./.env → ./.env.local
# 关掉自动加载：--no-env（或 $env:LIORIUM_ENV_FILE=""）
#
# 值里可以引用前面定义过的键：LIORIUM_INBOX=${LIORIUM_WORKSPACE}/.liorium-cli/agent

# ── 对话模型 ────────────────────────────────────────────────────────────────
# 显式指定 provider 配置（provider / key / base_url / 每模型格式）
# LIORIUM_PROVIDER_CONFIG=C:\Users\you\.liorium\providers.json
# 二选一：LIORIUM_MODEL 或 LIORIUM_PROVIDER + LIORIUM_MODEL
# LIORIUM_MODEL=Go::deepseek-v4.1-flash
# LIORIUM_PROVIDER=Go
# LIORIUM_API_FORMAT=openai_chat

# 没有 provider 配置文件时，也可以用这几个键直接拼一个 OpenAI 兼容 provider：
# LIORIUM_BASE_URL=https://api.deepseek.com
# LIORIUM_CHAT_KEY=sk-...
# LIORIUM_CHAT_MODEL=deepseek-chat
# LIORIUM_CONTEXT_WINDOW=128000
# LIORIUM_THINKING_TYPE=auto            # auto/openai/qwen/deepseek/glm/mimo/minimax/none

# ── 思考 ────────────────────────────────────────────────────────────────────
# 默认 medium 开启；off 关闭。aux/compact 调用永远不思考。
# LIORIUM_THINKING=medium              # off/low/medium/high
# LIORIUM_NO_THINKING=1                # 等价 --thinking off
# LIORIUM_HIDE_REASONING=1             # 只隐藏 reasoning_delta 显示，不改变是否请求

# ── models.dev 目录 ─────────────────────────────────────────────────────────
# 默认 cache：只读本地缓存、不联网；refresh 才下载。识别结果只影响本次会话，不回写配置。
# LIORIUM_MODELS_DEV=cache             # off/cache/refresh
# LIORIUM_MODELS_DEV_CACHE=            # 默认 ~/.liorium/cache/models_dev/api.json
# LIORIUM_REFRESH_MODELS=1             # 启动时从各 Provider /models 刷新模型列表（联网）

# ── 目录 ────────────────────────────────────────────────────────────────────
# LIORIUM_WORKSPACE=D:\dev\your-repo
# LIORIUM_INBOX=${LIORIUM_WORKSPACE}/.liorium-cli/agent
# LIORIUM_SYSTEM=                     # 用这个文件当 system prompt（替代 inbox/AGENT.md）
# LIORIUM_SKILLS_DIR=examples\skills

# ── 能力（realm） ───────────────────────────────────────────────────────────
# 工具全部来自 realm：core 不装就是零工具；记忆库指到已有的 memory 目录即可直接接管（同一套 schema）
# LIORIUM_MEMORY_DIR=C:\Users\you\.liorium\agents\<角色>\memory
# LIORIUM_NO_CORE_TOOLS=1             # 不装核心工具（read/write/edit/search/find/execute）
# LIORIUM_TOOLS=read,find             # 只装这些核心工具（逗号分隔；与 NO_CORE_TOOLS 互斥）
# LIORIUM_NO_MEMORY=1                 # 不启用长期记忆
# LIORIUM_NO_SKILLS=1                 # 不启用技能库
# LIORIUM_NO_TODO=1                   # 不启用待办（todo / todo_list + 每 50 回合提醒）
# LIORIUM_NO_SUBAGENTS=1              # 不启用子代理（newSubagent / invokeSubagent）
# LIORIUM_NO_VECTORS=1                # 只跑关键词检索（不建向量索引、不抽实体）
# LIORIUM_NO_EXTRACTION=1             # 向量照建，但不自动抽实体（省模型调用）

# ── 语义检索 / 实体抽取 ─────────────────────────────────────────────────────
# 不给 LIORIUM_EMBED_MODEL 就只跑关键词；给了才建向量索引并自动抽实体
# LIORIUM_EMBED_MODEL=text-embedding-3-small
# LIORIUM_EMBED_BASE_URL=             # 空 = 跟随当前 chat provider
# LIORIUM_EMBED_KEY=                  # 空 = 跟随当前 chat provider 的 key

# ── 运行参数 ────────────────────────────────────────────────────────────────
# LIORIUM_TEMPERATURE=0.3
# LIORIUM_MAX_TURNS=500
# LIORIUM_NO_COLOR=1                  # 关 ANSI 颜色
# LIORIUM_JSON=1                      # 事件以 JSON Lines 输出
# LIORIUM_PROMPT=                     # 单轮模式：执行一次就退出
